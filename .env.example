# ──────────────────────────────────────────────────────────────────────────────
# AEGIS – Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://pentest_user:pentest_password@localhost:5432/pentest_dev"

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"   # development | production

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a secret:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32+-char-secret"

# The full public URL of the app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ── Encryption ────────────────────────────────────────────────────────────────
# 32 hex characters (16 bytes) used to encrypt sensitive settings in the DB
# Generate:  openssl rand -hex 16
ENCRYPTION_KEY="replace-with-32-hex-chars-0000000"

# ── Optional integrations ─────────────────────────────────────────────────────
# Microsoft Teams incoming webhook URL for notifications
# TEAMS_WEBHOOK_URL="https://outlook.webhook.office.com/webhookb2/..."

# OpenAI / compatible API key for AI finding generation
# AI_API_KEY="sk-..."
