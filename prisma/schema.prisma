generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  initials  String   @default("")
  role      String   @default("Pentester")
  team      String   @default("Offensive")
  password  String
  createdAt DateTime @default(now())

  projectsLed   Project[]  @relation("ProjectLead")
  findings      Finding[]  @relation("FindingAssignee")
  reportAuthors Report[]   @relation("ReportAuthor")
  activities    Activity[]
  auditLogs     AuditLog[]
  approvedReportVersions ReportVersion[] @relation("ReportApprover")
  findingComments FindingComment[]
  notifications      Notification[] @relation("NotificationRecipient")
  notificationsActed Notification[] @relation("NotificationActor")
  watching           FindingWatcher[]
  burpPins           BurpPin[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  /// Discriminator: 'mention' | 'watch_status' | 'watch_severity' | 'watch_comment' | 'watch_assigned' | 'sla_breach_soon' | 'sla_overdue'
  type      String
  title     String   @default("")
  body      String   @default("")
  link      String   @default("")
  actorId   String?
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  findingId String?
  finding   Finding? @relation(fields: [findingId], references: [id], onDelete: Cascade)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model FindingWatcher {
  findingId String
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([findingId, userId])
}

model Project {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  engagement       String
  scope            String   @default("[]")
  executiveSummary String   @default("")
  methodology      String   @default("")
  attackNarrative  String   @default("")
  members          String   @default("[]")
  assetOwners      String   @default("[]")
  notes            String   @default("")
  status           String   @default("in-progress")
  progress         Int      @default(0)
  /// Corporate data-classification of the asset under test.
  /// C1 = Public, C2 = Internal, C3 = Confidential, C4 = Restricted.
  /// Drives CVSS environmental adjustment of the Confidentiality dimension
  /// and is fed to the AI prompt for context-aware impact wording.
  dataClassification String @default("C3")
  /// Asset criticality tier — Diamond > Silver > Bronze > Other.
  /// Drives CVSS environmental adjustment of the Integrity / Availability
  /// dimensions and again is passed to the AI for context.
  criticality        String @default("silver")
  /// Whether the engagement is "internal" (assumed-breach / on-network /
  /// employee perspective) or "external" (perimeter / public-facing). Drives
  /// SLA deadline computation since most clients hold internal tests to a
  /// laxer timeline than externally-exposed issues.
  engagementType        String   @default("external")
  /// Report section: key security strengths observed during the assessment.
  keySecurityStrengths  String   @default("")
  /// Report section: key areas requiring improvement.
  keyAreasForImprovement String  @default("")
  /// Report section: immediate actions (0-30 days).
  immediateActions       String @default("")
  /// Report section: short-term improvements (30-90 days).
  shortTermImprovements  String @default("")
  /// Report section: long-term strategic recommendations.
  longTermRecommendations String @default("")
  startDate        String
  endDate          String
  leadId           String
  lead             User     @relation("ProjectLead", fields: [leadId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  /// Burp Bridge — declared scope (hosts, one per line) that the ingest
  /// endpoint accepts traffic for. Empty = accept all (extension-side guard).
  burpScope         String @default("")
  /// How long ingested Burp traffic is retained before auto-cleanup.
  burpRetentionDays Int    @default(90)
  /// JSON capture rules: { dropHosts: string[], onlyTools: string[], dropStatic: boolean }
  burpCaptureRules String @default("{}")

  findings   Finding[]
  reports    Report[]
  activities Activity[]
  snapshots  ProjectSnapshot[]
  engagementKeys  EngagementKey[]
  burpTraffic     BurpTraffic[]
  burpEndpoints   BurpEndpoint[]
  burpChecklistItems BurpChecklistItem[]
  burpPins        BurpPin[]
  burpWebSocketMessages BurpWebSocketMessage[]
  burpAnalysisJobs BurpAnalysisJob[]
  burpReplayTasks  BurpReplayTask[]
  burpPairings     BurpPairing[]
}

model Finding {
  id           String   @id @default(cuid())
  code         String
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  severity     String   @default("medium")
  status       String   @default("open")
  cvss         Float    @default(0)
  cvssVector   String   @default("")
  cwe          String   @default("")
  owasp        String   @default("")
  component    String   @default("")
  assets       String   @default("[]")
  assigneeId   String?
  assignee     User?    @relation("FindingAssignee", fields: [assigneeId], references: [id])
  summary      String   @default("")
  description  String   @default("")
  reproduction String   @default("")
  impact       String   @default("")
  remediation  String   @default("")
  references   String   @default("")
  assetOwner   String   @default("")
  hasCVE       Boolean  @default(false)
  /// Manual drag-and-drop order within the project's Findings list and the
  /// rendered report. Default 999999 puts unsorted findings last so the
  /// severity ordering wins until the user explicitly reorders.
  sortOrder    Int      @default(999999)
  /// When true, the env-aware adjuster skips this finding entirely. The
  /// stored cvss / cvssVector / severity values are honoured exactly as the
  /// user set them. Useful for findings where the team explicitly does NOT
  /// want the project-level data class / criticality to influence the score.
  cvssLocked   Boolean  @default(false)
  discovered   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId, sortOrder])
  @@index([severity, createdAt(sort: Desc)])

  evidence   Evidence[]
  activities Activity[]
  comments   FindingComment[]
  watchers   FindingWatcher[]
  notifications Notification[]
  burpTraffic BurpTraffic[]
}

model Evidence {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  type      String   @default("screenshot")
  caption   String   @default("")
  content   String   @default("")
  filename  String   @default("")
  createdAt DateTime @default(now())
}

model VulnTemplate {
  id          String @id @default(cuid())
  code        String @unique
  title       String
  cwe         String @default("")
  severity    String @default("medium")
  owner       String @default("AppSec")
  description String @default("")
  reproduction String @default("")
  impact      String @default("")
  remediation String @default("")
  uses        Int    @default(0)
}

model ReportTemplate {
  id        String   @id @default(cuid())
  name      String
  audience  String   @default("Engineering")
  pages     String   @default("10+")
  tone      String   @default("Detailed")
  engine    String   @default("HTML")
  source    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports Report[]
}

model Report {
  id            String          @id @default(cuid())
  code          String          @unique
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId    String?
  template      ReportTemplate? @relation(fields: [templateId], references: [id])
  templateName  String          @default("")
  version       String          @default("v1")
  status        String          @default("draft")
  authorId      String
  author        User            @relation("ReportAuthor", fields: [authorId], references: [id])
  pages         Int             @default(0)
  size          String          @default("")
  // Review workflow fields (previously added manually outside Prisma)
  reviewerId    String?
  reviewComment String          @default("")
  reviewedAt    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  reportVersions ReportVersion[]
}

model Activity {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  findingId String?
  finding   Finding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  target    String
  detail    String   @default("")
  badge     String   @default("")
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  changes    String   @default("{}")
  createdAt  DateTime @default(now())
}

model ReportVersion {
  id              String   @id @default(cuid())
  reportId        String
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  versionNumber   Int
  status          String
  approvedBy      String?
  approver        User?    @relation("ReportApprover", fields: [approvedBy], references: [id])
  rejectionReason String   @default("")
  content         String   @default("")
  createdAt       DateTime @default(now())
}

model FindingComment {
  id        String   @id @default(cuid())
  findingId String
  finding   Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  mentions  String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectSnapshot {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshotDate DateTime
  criticalCount Int     @default(0)
  highCount    Int      @default(0)
  mediumCount  Int      @default(0)
  lowCount     Int      @default(0)
  createdAt    DateTime @default(now())
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  isSecret  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Burp Bridge ───────────────────────────────────────────────────────────────
// Live traffic ingestion from the Burp extension, endpoint inventory, AI
// checklist + anomaly detection, and finding ↔ traffic linkage.

/// Engagement secret key that authenticates the Burp extension to the ingest
/// endpoint. Only the SHA-256 hash is stored; the plaintext is shown once.
model EngagementKey {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyHash    String
  keyPrefix  String    @default("") // first 8 chars, for display
  label      String    @default("Burp extension")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([projectId])
  @@index([keyHash])
}

/// One captured request/response pair forwarded by the Burp extension.
model BurpTraffic {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Dedup hash: method|url|requestBody|responseBody
  sha256          String
  method          String
  url             String
  host            String
  path            String    // path including query string
  pathNoQuery     String
  query           String    @default("")
  statusCode      Int
  contentType     String    @default("")
  requestHeaders  String    @default("") // JSON object
  requestBody     String    @default("")
  responseHeaders String    @default("") // JSON object
  responseBody    String    @default("")
  /// proxy | repeater | intruder | scanner | manual — drives auto "tested"
  /// marking on the checklist (Repeater/Intruder activity counts as testing).
  tool            String    @default("proxy")
  sizeBytes       Int       @default(0)
  truncated       Boolean   @default(false)
  scopeOk         Boolean   @default(true)
  /// When true this exchange is the authenticated session anchor — replays and
  /// the payload runner inject its cookies/tokens into other requests.
  isSession       Boolean   @default(false)
  /// JSON array of {type,label,severity} auto/anomaly flags.
  anomalies       String    @default("[]")
  /// JSON array of {type,value(masked),context} secrets found in bodies.
  secrets         String    @default("[]")
  findingId       String?
  finding         Finding?  @relation(fields: [findingId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  pins BurpPin[]
  analysisJobs BurpAnalysisJob[]
  replayTasks  BurpReplayTask[]

  @@unique([projectId, sha256])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, findingId])
  @@index([host, pathNoQuery])
}

/// Normalized endpoint inventory derived from ingested traffic.
model BurpEndpoint {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  method        String
  host          String
  path          String    // normalized: /users/:id
  sampleUrl     String    @default("")
  hitCount      Int       @default(0)
  statusCodes   String    @default("[]")
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  isJsAsset     Boolean   @default(false)
  /// JSON array of {type,label,severity} aggregated flags.
  anomalies     String    @default("[]")
  testedCount   Int       @default(0)
  succeededCount Int      @default(0)
  createdAt     DateTime  @default(now())

  checklistItems BurpChecklistItem[]

  @@unique([projectId, method, host, path])
  @@index([projectId, lastSeenAt(sort: Desc)])
}

/// Attack-checklist item — AI-generated or from the curated cheatsheet.
model BurpChecklistItem {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpointId  String?
  endpoint    BurpEndpoint? @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      BurpChecklistItem? @relation("BurpChecklistParent", fields: [parentId], references: [id], onDelete: Cascade)
  children    BurpChecklistItem[] @relation("BurpChecklistParent")
  category    String   // xss | sqli | ssrf | idor | auth | …
  technique   String
  description String   @default("")
  payload     String   @default("")
  /// untested | tested | succeeded | failed | blocked
  status      String   @default("untested")
  resultNote  String   @default("")
  /// ai | cheatsheet | manual | bypass
  source      String   @default("ai")
  /// Set when tool activity auto-marked this item (repeater/intruder/proxy).
  autoMarkedBy String  @default("")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pins BurpPin[]

  @@index([projectId, status])
  @@index([projectId, category])
}

/// Pinned traffic rows ("interesting rail") — drag traffic to pin, promote
/// later to a finding draft. A pin references either a traffic row or a
/// checklist item.
model BurpPin {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trafficId String?
  traffic   BurpTraffic? @relation(fields: [trafficId], references: [id], onDelete: Cascade)
  checklistItemId String?
  checklistItem   BurpChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([projectId])
}

/// Captured WebSocket messages forwarded by the Burp extension.
model BurpWebSocketMessage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  host      String   @default("")
  url       String   @default("")
  /// sent | received
  direction String   @default("sent")
  content   String   @default("")
  tool      String   @default("proxy")
  createdAt DateTime @default(now())

  @@index([projectId, createdAt(sort: Desc)])
}

/// Queued AI analysis of captured assets (JS bundles, error responses) —
/// the backend auto-scans JS with the AI when it arrives.
model BurpAnalysisJob {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trafficId String?
  traffic   BurpTraffic? @relation(fields: [trafficId], references: [id], onDelete: Cascade)
  /// js | response
  kind      String   @default("js")
  /// pending | running | done | failed
  status    String   @default("pending")
  result    String   @default("")
  error     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
}

/// Replay tasks queued when the Aegis server can't reach the target — the
/// Burp extension pulls these and fires them from the tester's machine.
model BurpReplayTask {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trafficId String?
  traffic   BurpTraffic? @relation(fields: [trafficId], references: [id], onDelete: Cascade)
  method    String
  url       String
  requestHeaders String @default("{}")
  requestBody    String @default("")
  /// pending | done | failed
  status    String   @default("pending")
  result    String   @default("")
  sentVia   String   @default("burp")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
}

/// One-time pairing codes that auto-provision the Burp extension
/// (server URL + engagement key) without manual paste.
model BurpPairing {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([codeHash])
}
